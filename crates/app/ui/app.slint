import {
    Palette, LineEdit, SpinBox, CheckBox, ComboBox, Slider, ScrollView, ListView, AboutSlint
}
from "std-widgets.slint";
import {
    Icon, Glyph
}
from "icons.slint";
export struct TaskRow {
    id: int, title: string, estimate: int, completed: int, done: bool, selected: bool, deleted: bool, planned: bool, carried: bool
}
export struct ReportDay {
    label: string, minutes: string, fraction: float
}
export struct ReportTask {
    id: int, title: string, time: string, share: string, detail: string, fraction: float
}
export struct WidgetRow {
    title: string, description: string, enabled: bool, layer: int, click-through: bool
}
export global Tokens {
    in-out property <bool> reduced-motion: false;
    in-out property <bool> high-contrast: false;
    in-out property <color> system-background: #ffffff;
    in-out property <color> system-foreground: #000000;
    in-out property <color> system-highlight: #0000ff;
    in-out property <color> system-highlight-text: #ffffff;
    in-out property <color> system-muted: #777777;
    in-out property <bool> dark: false;
    out property <color> canvas: high-contrast ? system-background : dark ? #181b19 : #f5f3ee;
    out property <color> paper: high-contrast ? system-background : dark ? #222623 : #fcfbf8;
    out property <color> navigation: high-contrast ? system-background : dark ? #1d211e : #eceae3;
    out property <color> ink: high-contrast ? system-foreground : dark ? #f1f2ec : #242923;
    out property <color> muted: high-contrast ? system-foreground : dark ? #afb6ab : #62685e;
    out property <color> line: high-contrast ? system-foreground : dark ? #3b433b : #d9ddd3;
    out property <color> hover: high-contrast ? system-background : dark ? #303830 : #e7e8df;
    out property <color> selected: high-contrast ? system-highlight : dark ? #303a2e : #e7ebdd;
    out property <color> alert: high-contrast ? system-background : dark ? #3d3021 : #f3e0bd;
    out property <color> alert-ink: high-contrast ? system-foreground : dark ? #f5d5a1 : #5f401e;
    out property <color> coral: high-contrast ? system-highlight : dark ? #f0a18a : #a7432d;
    out property <color> teal: high-contrast ? system-highlight : dark ? #98cbbc : #217366;
    out property <color> indigo: high-contrast ? system-highlight : dark ? #b6bae5 : #545c9b;
    out property <color> button-text: high-contrast ? system-highlight-text : dark ? #231b17 : #ffffff;
}
component Caption inherits Text {
    color: Tokens.muted;
    font-size: 12px;
    wrap: word-wrap;
}
component Heading inherits Text {
    color: Tokens.ink;
    font-size: 27px;
    font-weight: 600;
    wrap: word-wrap;
}
component Rule inherits Rectangle {
    height: 1px;
    background: Tokens.line;
}
component Action inherits Rectangle {
    in property <string> text;
    in property <string> description: root.text;
    in property <Glyph> glyph: Glyph.none;
    in property <color> tint: Tokens.ink;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> left-aligned: false;
    in property <bool> quiet: false;
    in property <bool> checkable: false;
    in property <bool> checked: false;
    in property <bool> on-selection: false;
    callback clicked();
    height: 42px;
    min-width: text == "" ? 36px : max(76px, content.min-width);
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 8px;
    opacity: enabled ? 1 : 0.45;
    background: primary ? (Tokens.high-contrast ? Tokens.system-highlight : touch.pressed ? tint.darker(15%) : touch.has-hover ? tint.darker(5%) : tint) : (touch.pressed ? Tokens.line : touch.has-hover ? Tokens.hover : transparent);
    border-color: Tokens.high-contrast ? root.foreground : primary ? tint : quiet ? transparent : Tokens.line;
    border-width: 1px;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: description;
    accessible-enabled: enabled;
    accessible-checkable: checkable;
    accessible-checked: checked;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    animate background {
        duration: Tokens.reduced-motion ? 0ms : 100ms;
        easing: ease-out;
    }
    property <color> foreground: primary || (on-selection && Tokens.high-contrast && !touch.has-hover && !touch.pressed) ? (Tokens.high-contrast ? Tokens.system-highlight-text : Tokens.button-text) : (Tokens.high-contrast ? Tokens.ink : tint);
    content := HorizontalLayout {
        padding-left: root.text == "" ? 8px : 12px;
        padding-right: root.text == "" ? 8px : 12px;
        spacing: 8px;
        alignment: root.left-aligned ? start : center;
        if root.glyph != Glyph.none: Icon {
            glyph: root.glyph;
            ink: root.foreground;
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.foreground;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    if focus.has-focus && root.enabled: Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-width: 2px;
        border-color: root.foreground;
        border-radius: 6px;
        background: transparent;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}
component Ring inherits Rectangle {
    in property <string> time;
    in property <string> path;
    in property <string> label;
    in property <color> accent;
    background: transparent;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 240;
        viewbox-height: 240;
        commands: "M120 5 A115 115 0 1 1 120 235 A115 115 0 1 1 120 5";
        stroke: Tokens.line;
        stroke-width: 3px;
        fill: transparent;
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 240;
        viewbox-height: 240;
        commands: root.path;
        stroke: Tokens.high-contrast ? Tokens.system-highlight : root.accent;
        stroke-width: 3px;
        stroke-line-cap: round;
        fill: transparent;
    }
    VerticalLayout {
        alignment: center;
        spacing: 8px;
        Text {
            text: root.time;
            font-family: "Consolas";
            font-size: root.width >= 230px ? 64px : root.width >= 180px ? 48px : 36px;
            font-weight: 500;
            color: Tokens.ink;
            horizontal-alignment: center;
        }
        Caption {
            text: root.label;
            horizontal-alignment: center;
        }
    }
}
component ReportEntry inherits Rectangle {
    in property <ReportTask> entry;
    callback inspect(int,string);
    height:78px;background:transparent;
    VerticalLayout {padding-top:8px;padding-bottom:8px;padding-right:8px;spacing:7px;
        HorizontalLayout {spacing:10px;
            VerticalLayout {horizontal-stretch:1;spacing:3px;Text {text:root.entry.title;color:Tokens.ink;font-weight:600;overflow:elide;} Caption {text:root.entry.detail;}}
            Text {text:root.entry.time;color:Tokens.ink;font-size:19px;font-weight:600;vertical-alignment:center;min-width:74px;}
            Caption {text:root.entry.share;vertical-alignment:center;width:46px;horizontal-alignment:right;}
            Action {glyph:Glyph.info;description:"Session details for "+root.entry.title;quiet:true;width:34px;height:34px;clicked=>{root.inspect(root.entry.id,root.entry.title);}}
        }
        Rectangle {height:3px;background:Tokens.line;border-radius:2px;Rectangle {x:0px;y:0px;width:parent.width*root.entry.fraction;height:parent.height;background:Tokens.coral;border-radius:2px;}}
    }
}

export struct SettingsDraft {
    focus: int, short: int, long: int, interval: int, auto-focus: bool, auto-breaks: bool, volume: int, sound: int, notifications: bool, motion: bool, mica: bool, startup: bool, appearance: int, toggle: string, show: string, skip: string
}
export component MainWindow inherits Window {
    property <bool> dark-mode: Tokens.dark;
    init => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-mode => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    title:"Orbit · Focus";
    preferred-width:940px;
    preferred-height:740px;
    min-width:760px;
    min-height:540px;
    background:root.mica-active && !Tokens.high-contrast ? (Tokens.dark ? #181b19ee : #f5f3eeee) : Tokens.canvas;
    default-font-family:"Segoe UI";
    default-font-size:14px;
    no-frame:true;
    property <bool> widget-advanced;
    in property <bool> compact: false;
    in property <string> time-text: "25:00";
    in property <string> ring-path;
    in property <string> mode-label: "Focus";
    in property <string> state-label: "Ready";
    in property <string> active-task: "No task selected";
    in property <int> mode: 0;
    in property <bool> running: false;
    in property <bool> mica-active: false;
    in property <int> cycle: 0;
    in property <[TaskRow]> tasks;
    in property <[WidgetRow]> widgets;
    in property <[ReportDay]> report-days;
    in property <[ReportTask]> report-tasks;
    in property <[ReportTask]> report-preview;
    in-out property <bool> report-task-list;
    in-out property <string> range-error;
    in property <string> report-title;
    in property <string> report-time: "0m";
    in property <string> report-partial: "0m";
    in property <int> report-completed;
    in-out property <int> report-period: 1;
    in-out property <int> page: 0;
    in-out property <string> message;
    in-out property <string> task-title;
    in-out property <int> task-estimate: 1;
    in-out property <int> edit-id: -1;
    in-out property <int> focus-minutes: 25;
    in-out property <int> short-minutes: 5;
    in-out property <int> long-minutes: 15;
    in-out property <int> long-interval: 4;
    in-out property <bool> auto-breaks;
    in-out property <bool> auto-focus;
    in-out property <int> volume: 65;
    in-out property <int> sound: 0;
    in-out property <bool> notifications: true;
    in-out property <bool> reduced-motion;
    in-out property <bool> mica;
    in-out property <bool> autostart;
    in-out property <string> toggle-hotkey;
    in-out property <string> show-hotkey;
    in-out property <string> skip-hotkey;
    property <color> accent: Tokens.coral;
    callback control(string);
    callback select-mode(int);
    callback task-action(int,string);
    callback save-task();
    callback save-settings();
    callback preview-sound();
    callback report-change(int,int);
    callback widget-change(int,bool,int,bool);
    callback widget-reset(int);
    callback register-notifications();
    callback open-data-folder();
    callback navigate(int);
    in property <[TaskRow]> picker-tasks;
    in property <bool> started;
    in property <bool> can-start-task: true;
    in property <string> next-task;
    in property <string> cycle-label;
    in property <string> today-label: "Choose your next focus";
    in property <bool> storage-blocked;
    in-out property <string> save-status: "Saved";
    in-out property <bool> settings-saving;
    in-out property <bool> task-saving;
    in-out property <bool> data-busy;
    in-out property <string> data-status;
    in property <string> data-location;
    in-out property <string> restore-path;
    in-out property <bool> confirm-quit;
    in-out property <string> confirm-action;
    in-out property <int> confirm-mode: -1;
    in-out property <int> appearance;
    in property <SettingsDraft> saved-settings;
    out property <bool> settings-dirty: root.focus-minutes != saved-settings.focus || root.short-minutes != saved-settings.short || root.long-minutes != saved-settings.long || root.long-interval != saved-settings.interval || root.auto-focus != saved-settings.auto-focus || root.auto-breaks != saved-settings.auto-breaks || root.volume != saved-settings.volume || root.sound != saved-settings.sound || root.notifications != saved-settings.notifications || root.reduced-motion != saved-settings.motion || root.mica != saved-settings.mica || root.autostart != saved-settings.startup || root.appearance != saved-settings.appearance || root.toggle-hotkey != saved-settings.toggle || root.show-hotkey != saved-settings.show || root.skip-hotkey != saved-settings.skip;
    in-out property <int> settings-section;
    in-out property <string> settings-error;
    in-out property <int> recording-shortcut: -1;
    callback capture-shortcut(int,string);
    callback begin-capture(int);
    callback cancel-capture();
    in property <string> chart-note;
    in-out property <int> task-view: 0;
    in-out property <string> task-search;
    in-out property <int> task-menu: -1;
    in-out property <int> undo-id: -1;
    in-out property <string> detail-title;
    in-out property <string> range-start;
    in-out property <string> range-end;
    property <bool> quick-add;
    property <color> mode-accent: mode == 0 ? Tokens.coral : mode == 1 ? Tokens.teal : Tokens.indigo;
    callback filter-tasks();
    callback save-and-start();
    callback custom-report();
    callback task-history(int);
    in-out property <[string]> detail-rows;
    HorizontalLayout {
        spacing:0px;
        Rectangle {
            width:root.compact ? 152px : 160px;
            background:Tokens.navigation;
            VerticalLayout {
                padding:16px;
                spacing:8px;
                HorizontalLayout {
                    height:56px;
                    spacing:8px;
                    Icon {
                        glyph:Glyph.orbit;
                        ink:Tokens.coral;
                        width:26px;
                        height:26px;
                        y:(parent.height - self.height)/2;
                    }
                    Text {
                        text:"Orbit";
                        font-size:28px;
                        font-weight:600;
                        color:Tokens.ink;
                        vertical-alignment:center;
                    }
                }
                for name[i] in ["Timer","Tasks","Reports"]: Action {
                    text:name;
                    glyph:i==0 ? Glyph.timer : i==1 ? Glyph.tasks : Glyph.reports;
                    left-aligned:true;
                    quiet:true;
                    primary:root.page==i;
                    tint:Tokens.ink;
                    checkable:true;
                    checked:root.page==i;
                    clicked=>{
                        root.page=i;
                        root.navigate(i);
                    }
                }
                Rectangle {
                    vertical-stretch:1;
                    background:transparent;
                }
                Action {
                    text:"Settings";
                    glyph:Glyph.settings;
                    left-aligned:true;
                    quiet:true;
                    primary:root.page>=3;
                    tint:Tokens.ink;
                    clicked=>{
                        root.page=4;
                        root.navigate(4);
                    }
                }
                Action {
                    text:"Hide to tray";
                    glyph:Glyph.hide;
                    left-aligned:true;
                    quiet:true;
                    clicked=>{
                        root.control("hide");
                    }
                }
                Action {
                    text:"Quit";
                    glyph:Glyph.power;
                    left-aligned:true;
                    quiet:true;
                    height:34px;
                    clicked=>{
                        root.control("quit");
                    }
                }
            }
        }
        VerticalLayout {
            spacing:0px;
            Rectangle {
                height:44px;
                background:transparent;
                WindowMoveArea {
                }
                HorizontalLayout {
                    padding-left:28px;
                    padding-right:12px;
                    spacing:6px;
                    Caption {
                        text:"";
                        horizontal-stretch:1;
                    }
                    Action {
                        glyph:Glyph.minimize;
                        description:"Minimize";
                        quiet:true;
                        width:34px;
                        height:34px;
                        y:5px;
                        clicked=>{
                            root.control("minimize");
                        }
                    }
                    Action {
                        glyph:Glyph.close;
                        description:"Hide to tray";
                        quiet:true;
                        width:34px;
                        height:34px;
                        y:5px;
                        clicked=>{
                            root.control("hide");
                        }
                    }
                }
            }
            if root.storage-blocked: Rectangle {
                background:Tokens.alert;
                height:68px;
                HorizontalLayout {
                    padding:10px;
                    spacing:10px;
                    VerticalLayout {
                        horizontal-stretch:1;
                        Text {
                            text:"Could not save · Timer paused";
                            color:Tokens.alert-ink;
                            font-weight:600;
                        }
                        Text {
                            text:root.save-status;
                            color:Tokens.alert-ink;
                            font-size:12px;
                            overflow:elide;
                        }
                    }
                    Action {
                        text:"Retry saving";
                        height:36px;
                        clicked=>{
                            root.control("retry");
                        }
                    }
                }
            }
            if root.message!="" && !root.storage-blocked: Rectangle {
                background:Tokens.alert;
                height:max(48px,notice.min-height+12px);
                notice:=HorizontalLayout {
                    padding:6px;
                    spacing:8px;
                    Text {
                        text:root.message;
                        color:Tokens.alert-ink;
                        font-size:12px;
                        wrap:word-wrap;
                        horizontal-stretch:1;
                    }
                    Action {
                        glyph:Glyph.close;
                        description:"Dismiss message";
                        quiet:true;
                        width:34px;
                        height:34px;
                        clicked=>{
                            root.message="";
                        }
                    }
                }
            }
            if root.confirm-action!="" || root.confirm-mode>=0: Rectangle {
                background:Tokens.alert;
                height:84px;
                HorizontalLayout {
                    padding:10px;
                    spacing:8px;
                    Text {
                        text:"End this session? Elapsed focus stays in reports; this session will not count as completed.";
                        wrap:word-wrap;
                        color:Tokens.alert-ink;
                        horizontal-stretch:1;
                        font-size:12px;
                    }
                    Action {
                        text:"Continue";
                        height:36px;
                        clicked=>{
                            if root.confirm-mode>=0 {
                                root.select-mode(root.confirm-mode);
                            }
                            else {
                                root.control(root.confirm-action);
                            }
                            root.confirm-action="";
                            root.confirm-mode=-1;
                        }
                    }
                    Action {
                        text:"Cancel";
                        height:36px;
                        clicked=>{
                            root.confirm-action="";
                            root.confirm-mode=-1;
                        }
                    }
                }
            }
            if root.confirm-quit: Rectangle {
                background:Tokens.alert;
                height:72px;
                HorizontalLayout {
                    padding:10px;
                    spacing:8px;
                    Text {
                        text:"You have unsaved settings.";
                        color:Tokens.alert-ink;
                        wrap:word-wrap;
                        horizontal-stretch:1;
                    }
                    Action {
                        text:"Discard & quit";
                        height:36px;
                        clicked=>{
                            root.confirm-quit=false;
                            root.control("quit-discard");
                        }
                    }
                    Action {
                        text:"Keep editing";
                        height:36px;
                        clicked=>{
                            root.confirm-quit=false;
                            root.page=4;
                        }
                    }
                }
            }
            if root.restore-path!="": Rectangle {
                background:Tokens.alert;
                height:108px;
                VerticalLayout {
                    padding:10px;
                    spacing:6px;
                    Text {
                        text:"Replace local data with "+root.restore-path+"? Current data will be backed up first.";
                        color:Tokens.alert-ink;
                        wrap:word-wrap;
                        font-size:12px;
                    }
                    HorizontalLayout {
                        spacing:8px;
                        Action {
                            text:"Replace local data";
                            height:34px;
                            clicked=>{
                                root.control("restore-confirm");
                            }
                        }
                        Action {
                            text:"Cancel";
                            height:34px;
                            clicked=>{
                                root.restore-path="";
                            }
                        }
                    }
                }
            }
            if root.page == 0: VerticalLayout {
                padding-left: root.compact ? 24px : 36px;
                padding-right: root.compact ? 24px : 36px;
                padding-top: 8px;
                padding-bottom: 20px;
                spacing: root.compact ? 8px : 12px;
                HorizontalLayout {
                    Heading {
                        text: "Time to focus";
                        horizontal-stretch: 1;
                    }
                    Caption {
                        text: root.storage-blocked ? "Waiting to save" : root.running ? "In progress" : root.started ? "Paused" : "Ready when you are";
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    for name[i] in ["Focus", "Short break", "Long break"]: Action {
                        text: name;
                        height: 34px;
                        horizontal-stretch: 1;
                        primary: root.mode == i;
                        tint: root.mode-accent;
                        enabled: !root.storage-blocked && !root.data-busy;
                        clicked => {
                            if root.started {
                                root.confirm-mode=i;
                            }
                            else {
                                root.select-mode(i);
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;
                        background: Tokens.paper;
                        border-radius: 8px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 4px;
                            spacing: 6px;
                            Icon {
                                glyph: Glyph.tasks;
                                ink: Tokens.muted;
                                y: (parent.height - self.height)/2;
                            }
                            Text {
                                text: root.active-task;
                                overflow: elide;
                                color: Tokens.ink;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                font-weight: 600;
                            }
                            Action {
                                glyph: Glyph.chevron;
                                description: "Choose a task";
                                quiet: true;
                                width: 36px;
                                height: 36px;
                                clicked => {
                                    root.task-view=1;
                                    root.task-search="";
                                    root.filter-tasks();
                                    picker.show();
                                }
                            }
                        }
                    }
                    Action {
                        glyph: root.quick-add ? Glyph.close : Glyph.add;
                        description: "Add a task";
                        quiet: true;
                        width: 38px;
                        height: 38px;
                        clicked => {
                            if !root.quick-add {
                                root.edit-id=-1;
                                root.task-title="";
                                root.task-estimate=1;
                            }
                            root.quick-add=!root.quick-add;
                        }
                    }
                }
                if root.quick-add: HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        horizontal-stretch: 1;
                        height: 38px;
                        text <=> root.task-title;
                        enabled: !root.task-saving && !root.storage-blocked && !root.data-busy;
                        placeholder-text: "What will you work on?";
                        accessible-label: "New focus task";
                        accepted => {
                            if root.can-start-task {
                                root.save-and-start();
                            }
                            else {
                                root.save-task();
                            }
                        }
                    }
                    Action {
                        text: root.can-start-task ? "Add & start" : "Add task";
                        height: 38px;
                        primary: true;
                        tint: Tokens.coral;
                        enabled: root.task-title!="" && !root.task-saving && !root.storage-blocked && !root.data-busy;
                        clicked => {
                            if root.can-start-task {
                                root.save-and-start();
                            }
                            else {
                                root.save-task();
                            }
                        }
                    }
                }
                Rectangle {
                    background: transparent;
                    vertical-stretch: 1;
                    min-height: root.compact ? 125px : 190px;
                    Ring {
                        width: min(root.compact ? 196px : 276px,parent.height - 2px);
                        height: self.width;
                        x:(parent.width - self.width)/2;
                        y:(parent.height - self.height)/2;
                        time:root.time-text;
                        path:root.ring-path;
                        label:root.storage-blocked ? "Saving interrupted" : root.state-label;
                        accent:root.mode-accent;
                    }
                }
                if root.next-task != "": Text {
                    text: root.next-task;
                    color: Tokens.muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 10px;
                    Action {
                        glyph: Glyph.reset;
                        description: "Reset session";
                        quiet: true;
                        enabled: !root.storage-blocked && !root.data-busy;
                        clicked => {
                            if root.started {
                                root.confirm-action="reset";
                            }
                            else {
                                root.control("reset");
                            }
                        }
                    }
                    Action {
                        text: root.running ? "Pause session" : root.started ? "Resume session" : "Start session";
                        glyph: root.running ? Glyph.pause : Glyph.play;
                        primary: true;
                        tint: Tokens.coral;
                        horizontal-stretch: 1;
                        enabled: !root.storage-blocked && !root.data-busy;
                        clicked => {
                            root.control("toggle");
                        }
                    }
                    Action {
                        glyph: Glyph.skip;
                        description: "Skip session";
                        quiet: true;
                        enabled: !root.storage-blocked && !root.data-busy;
                        clicked => {
                            if root.started {
                                root.confirm-action="skip";
                            }
                            else {
                                root.control("skip");
                            }
                        }
                    }
                }
                Caption {
                    text: root.cycle-label;
                    horizontal-alignment: center;
                }
                Rule {
                }
                HorizontalLayout {
                    Caption {
                        text: root.today-label;
                        horizontal-stretch: 1;
                    }
                    Caption {
                        text: root.toggle-hotkey == "" ? "Sleep pauses elapsed time" : root.toggle-hotkey + " · Start / pause";
                    }
                }
            }
            if root.page == 1: VerticalLayout {
                padding: root.compact ? 24px : 30px;
                spacing: 12px;
                HorizontalLayout {
                    Heading {
                        text:"Your work";
                        horizontal-stretch:1;
                    }
                    Caption {
                        text:root.tasks.length + " tasks";
                        vertical-alignment:center;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    ComboBox {
                        model:["Today","All active","Completed","Trash","Carry forward"];
                        current-index <=> root.task-view;
                        selected(value) => {
                            root.task-menu=-1;
                            root.filter-tasks();
                        }
                        accessible-label:"Task view";
                    }
                    LineEdit {
                        text <=> root.task-search;
                        placeholder-text:"Search tasks";
                        accessible-label:"Search tasks";
                        horizontal-stretch:1;
                        edited => {
                            root.filter-tasks();
                        }
                    }
                }
                if root.task-view < 2 || root.edit-id >= 0: HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> root.task-title;
                        placeholder-text:"Add something worth focusing on";
                        accessible-label:"Task title";
                        horizontal-stretch:1;
                        enabled:!root.task-saving && !root.storage-blocked && !root.data-busy;
                        accepted=>{
                            root.save-task();
                        }
                    }
                    SpinBox {
                        value <=> root.task-estimate;
                        minimum:1;
                        maximum:99;
                        width:72px;
                        accessible-label:"Estimated sessions";
                    }
                    Action {
                        text:root.edit-id < 0 ? "Add" : "Save";
                        glyph:root.edit-id < 0 ? Glyph.add : Glyph.save;
                        primary:true;
                        tint:Tokens.coral;
                        height:38px;
                        enabled:root.task-title!="" && !root.task-saving && !root.storage-blocked && !root.data-busy;
                        clicked=>{
                            root.save-task();
                        }
                    }
                }
                if root.edit-id >= 0: Action {
                    text:"Cancel editing";
                    quiet:true;
                    height:32px;
                    clicked=>{
                        root.edit-id=-1;
                        root.task-title="";
                        root.task-estimate=1;
                    }
                }
                if root.tasks.length == 0: VerticalLayout {
                    alignment:center;
                    spacing:8px;
                    Text {
                        text:root.task-view==0 ? "A clear day starts here" : root.task-view==3 ? "Nothing in Trash" : "No matching tasks";
                        font-size:22px;
                        color:Tokens.ink;
                    }
                    Caption {
                        text:root.task-view==0 ? "Add a task, or choose All active and plan a few things for today." : "Try another view or search. Your focus history stays intact.";
                        wrap:word-wrap;
                    }
                }
                ListView {
                    vertical-stretch:1;
                    for task in root.tasks: Rectangle {
                        height:root.task-menu==task.id ? 122px : 66px;
                        background:task.selected ? Tokens.selected : transparent;
                        border-radius:8px;
                        VerticalLayout {
                            padding:8px;
                            spacing:6px;
                            HorizontalLayout {
                                spacing:8px;
                                if !task.deleted: CheckBox {
                                    checked:task.done;
                                    accessible-label:"Complete "+task.title;
                                    enabled:!root.storage-blocked && !root.data-busy;
                                    toggled=>{
                                        root.task-action(task.id,"done");
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch:1;
                                    spacing:3px;
                                    alignment:center;
                                    Text {
                                        text:task.title;
                                        overflow:elide;
                                        color:task.selected && Tokens.high-contrast ? Tokens.system-highlight-text : Tokens.ink;
                                        font-size:14px;
                                        font-weight:600;
                                    }
                                    Caption {
                                        text:task.completed+" / "+task.estimate+" sessions"+(task.planned ? " · Today" : task.carried ? " · Earlier plan" : "");
                                        color:task.selected && Tokens.high-contrast ? Tokens.system-highlight-text : Tokens.muted;
                                    }
                                }
                                if !task.done && !task.deleted: Action {
                                    text:root.can-start-task ? "Start focus" : task.selected ? "Next" : "Use next";
                                    glyph:task.selected ? Glyph.check : Glyph.play;
                                    on-selection:task.selected;
                                    height:36px;
                                    enabled:!root.storage-blocked && !root.data-busy;
                                    clicked=>{
                                        root.task-action(task.id,"start");
                                    }
                                }
                                if task.deleted: Action {
                                    text:"Restore";
                                    glyph:Glyph.reset;
                                    height:36px;
                                    enabled:!root.storage-blocked && !root.data-busy;
                                    clicked=>{
                                        root.task-action(task.id,"restore");
                                    }
                                }
                                Action {
                                    glyph:Glyph.more;
                                    description:"More actions for "+task.title;
                                    quiet:true;
                                    width:36px;
                                    height:36px;
                                    on-selection:task.selected;
                                    clicked=>{
                                        root.task-menu=root.task-menu==task.id ? -1 : task.id;
                                    }
                                }
                            }
                            if root.task-menu==task.id: HorizontalLayout {
                                spacing:6px;
                                Action {
                                    glyph:Glyph.info;
                                    description:"Read full task title";
                                    quiet:true;
                                    width:36px;
                                    height:32px;
                                    clicked=>{
                                        root.task-action(task.id,"details");
                                        details.show();
                                    }
                                }
                                if !task.deleted: Action {
                                    glyph:Glyph.edit;
                                    description:"Edit task";
                                    quiet:true;
                                    width:36px;
                                    height:32px;
                                    clicked=>{
                                        root.task-action(task.id,"edit");
                                    }
                                }
                                if !task.deleted && !task.done: Action {
                                    text:task.planned ? "Remove today" : "Plan today";
                                    quiet:true;
                                    height:32px;
                                    enabled:!root.storage-blocked && !root.data-busy;
                                    clicked=>{
                                        root.task-action(task.id,task.planned ? "unplan" : "plan");
                                    }
                                }
                                if task.planned && !task.done && !task.deleted: Action {
                                    glyph:Glyph.up;
                                    description:"Move task up";
                                    quiet:true;
                                    width:36px;
                                    height:32px;
                                    clicked=>{
                                        root.task-action(task.id,"up");
                                    }
                                }
                                if task.planned && !task.done && !task.deleted: Action {
                                    glyph:Glyph.chevron;
                                    description:"Move task down";
                                    quiet:true;
                                    width:36px;
                                    height:32px;
                                    clicked=>{
                                        root.task-action(task.id,"down");
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch:1;
                                    background:transparent;
                                }
                                if !task.deleted: Action {
                                    glyph:Glyph.trash;
                                    description:"Delete task";
                                    quiet:true;
                                    width:36px;
                                    height:32px;
                                    enabled:!root.storage-blocked && !root.data-busy;
                                    clicked=>{
                                        root.task-action(task.id,"delete");
                                    }
                                }
                            }
                        }
                    }
                }
                if root.undo-id >= 0: HorizontalLayout {
                    Caption {
                        text:"Task deleted. You can also restore it from Trash.";
                        horizontal-stretch:1;
                    }
                    Action {
                        text:"Undo";
                        height:34px;
                        clicked=>{
                            root.task-action(root.undo-id,"restore");
                        }
                    }
                }
            }
            if root.page == 2 && !root.report-task-list: ScrollView {
                VerticalLayout {
                    alignment: start;
                    padding: 28px;
                    spacing: 20px;
                    HorizontalLayout {
                        Heading {
                            text: "Focus, in perspective";
                            horizontal-stretch: 1;
                        }
                        Action {
                            text: "Export CSV";
                            glyph: Glyph.save;
                            height: 36px;
                            enabled: !root.data-busy;
                            clicked => {
                                root.control("export");
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        ComboBox {
                            accessible-label: "Report period";
                            model: ["Daily", "Weekly", "Monthly"];
                            current-index <=> root.report-period;
                            selected(value) => {
                                root.report-change(self.current-index,0);
                            }
                        }
                        Action {
                            glyph: Glyph.previous;
                            description: "Previous period";
                            width: 36px;
                            height: 36px;
                            clicked => {
                                root.report-change(root.report-period,-1);
                            }
                        }
                        Text {
                            text: root.report-title;
                            wrap: word-wrap;
                            font-size: 13px;
                            color: Tokens.ink;
                            horizontal-stretch: 1;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Action {
                            glyph: Glyph.next;
                            description: "Next period";
                            width: 36px;
                            height: 36px;
                            clicked => {
                                root.report-change(root.report-period,1);
                            }
                        }
                        Action {
                            text: root.report-period == 0 ? "Today" : root.report-period == 1 ? "This week" : "This month";
                            glyph: Glyph.calendar;
                            height: 36px;
                            clicked => {
                                root.report-change(root.report-period,2);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing:8px;
                        LineEdit {
                            text <=> root.range-start;
                            placeholder-text:"From YYYY-MM-DD";
                            accessible-label:"Report start date";
                            horizontal-stretch:1;
                        }
                        LineEdit {
                            text <=> root.range-end;
                            placeholder-text:"To YYYY-MM-DD";
                            accessible-label:"Report end date";
                            horizontal-stretch:1;
                        }
                        Action {
                            text:"Apply range";
                            height:34px;
                            clicked=>{
                                root.custom-report();
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 30px;
                        VerticalLayout {
                            Text {
                                text: root.report-time;
                                color: Tokens.ink;
                                font-size: 33px;
                                font-weight: 600;
                            }
                            Caption {
                                text: "ACTIVE FOCUS";
                            }
                        }
                        VerticalLayout {
                            Text {
                                text: root.report-completed;
                                color: Tokens.ink;
                                font-size: 33px;
                                font-weight: 600;
                            }
                            Caption {
                                text: "COMPLETED POMODOROS";
                            }
                        }
                    }
                    Rule {
                    }
                    if root.range-error!="": Text {text:root.range-error;color:Tokens.alert-ink;wrap:word-wrap;}
                if root.chart-note!="": Caption {
                        text:root.chart-note;
                    }
                    Text {
                        text: "Focus by day";
                        color: Tokens.ink;
                        font-size: 18px;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        height: root.compact ? 150px : 210px;
                        for day in root.report-days: VerticalLayout {
                            spacing: 8px;
                            Rectangle {
                                background: transparent;
                                vertical-stretch: 1;
                                Rectangle {
                                    x: 2px;
                                    y: parent.height - self.height;
                                    width: parent.width - 4px;
                                    height: max(2px, (parent.height - 28px) * day.fraction);
                                    background: root.accent;
                                    border-radius: 3px;
                                }
                                Text {
                                    text: root.report-days.length <= 7 ? day.minutes : "";
                                    y: max(0px,parent.height - (parent.height - 28px)*day.fraction - 23px);
                                    color: Tokens.muted;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    width: parent.width;
                                }
                            }
                            Caption {
                                text: day.label;
                                horizontal-alignment: center;
                                font-size: root.report-days.length > 7 ? 10px : 12px;
                            }
                        }
                    }
                    Rule {
                    }
                    Text {
                        text: "Focus by task";
                        color: Tokens.ink;
                        font-size: 18px;
                        font-weight: 600;
                    }
                    Caption {
                        text: "Time spent and share of total focus in this period, including partial sessions.";
                    }
                    if root.report-tasks.length == 0: Caption {
                        text: "No focus time yet. Select a task and start a focus session to see your breakdown here.";
                    }
                    for task in root.report-preview: ReportEntry {entry:task; inspect(id,title)=>{root.detail-title=title;root.detail-rows=["Loading session details…"];root.task-history(id);details.show();}}
                if root.report-tasks.length>0: Action {text:"View all "+root.report-tasks.length+" tasks";quiet:true;clicked=>{root.report-task-list=true;}}
                    Rule {
                    }
                    Caption {
                        text: root.report-partial + " from partial or in-progress sessions. Pauses and sleep are excluded.";
                        wrap: word-wrap;
                    }
                    Caption {
                        text: "Dates use your Windows time zone.";
                        wrap: word-wrap;
                    }
                }
            }
            if root.page==2 && root.report-task-list: VerticalLayout {padding:28px;spacing:16px;
                HorizontalLayout {Heading {text:"Focus by task";horizontal-stretch:1;} Action {text:"Back to overview";glyph:Glyph.previous;height:36px;clicked=>{root.report-task-list=false;}}}
                Caption {text:root.report-title;}
                ListView {vertical-stretch:1;for task in root.report-tasks: ReportEntry {entry:task;inspect(id,title)=>{root.detail-title=title;root.detail-rows=["Loading session details…"];root.task-history(id);details.show();}}}
            }
            if root.page == 4: VerticalLayout {
                padding:root.compact ? 24px : 30px;
                spacing:14px;
                Heading {
                    text:"Make it yours";
                }
                if root.settings-error!="": Text {
                    text:root.settings-error;
                    color:Tokens.alert-ink;
                    wrap:word-wrap;
                    font-size:13px;
                }
                ComboBox {
                    model:["Sessions","Notifications & sound","Appearance","Shortcuts & startup","Widgets","Data","About"];
                    current-index <=> root.settings-section;
                selected(value) => {root.cancel-capture();}
                    accessible-label:"Settings section";
                }
                ScrollView {
                    vertical-stretch:1;
                    VerticalLayout {
                        alignment:start;
                        padding-right:12px;
                        spacing:16px;
                        if root.settings-section==0: VerticalLayout {
                            spacing:12px;
                            Text {
                                text:"Your focus rhythm";
                                color:Tokens.ink;
                                font-size:18px;
                                font-weight:600;
                            }
                            Caption {
                                text:"Changes apply to the next session. Sleep never consumes focus time.";
                            }
                            HorizontalLayout {
                                spacing:12px;
                                VerticalLayout {
                                    Caption {
                                        text:"Focus · minutes";
                                    }
                                    SpinBox {
                                        value <=> root.focus-minutes;
                                        minimum:1;
                                        maximum:180;
                                        accessible-label:"Focus duration";
                                    }
                                }
                                VerticalLayout {
                                    Caption {
                                        text:"Short break";
                                    }
                                    SpinBox {
                                        value <=> root.short-minutes;
                                        minimum:1;
                                        maximum:180;
                                        accessible-label:"Short break duration";
                                    }
                                }
                                VerticalLayout {
                                    Caption {
                                        text:"Long break";
                                    }
                                    SpinBox {
                                        value <=> root.long-minutes;
                                        minimum:1;
                                        maximum:180;
                                        accessible-label:"Long break duration";
                                    }
                                }
                            }
                            HorizontalLayout {
                                Caption {
                                    text:"Long break after completed focus sessions";
                                    horizontal-stretch:1;
                                    vertical-alignment:center;
                                }
                                SpinBox {
                                    value <=> root.long-interval;
                                    minimum:1;
                                    maximum:12;
                                    accessible-label:"Long break interval";
                                }
                            }
                            CheckBox {
                                text:"Automatically start breaks";
                                checked <=> root.auto-breaks;
                            }
                            CheckBox {
                                text:"Automatically start focus sessions";
                                checked <=> root.auto-focus;
                            }
                        }
                        if root.settings-section==1: VerticalLayout {
                            spacing:12px;
                            Text {
                                text:"A gentle cue to move on";
                                color:Tokens.ink;
                                font-size:18px;
                                font-weight:600;
                            }
                            ComboBox {
                                model:["Soft bell","Wood chime","Gentle double"];
                                current-index <=> root.sound;
                                accessible-label:"Alarm sound";
                            }
                            HorizontalLayout {
                                spacing:10px;
                                Slider {
                                    value:root.volume;
                                    minimum:0;
                                    maximum:100;
                                    horizontal-stretch:1;
                                    accessible-label:"Alarm volume";
                                    changed(value)=>{
                                        root.volume=round(value);
                                    }
                                }
                                Caption {
                                    text:root.volume+"%";
                                    vertical-alignment:center;
                                }
                                Action {
                                    text:"Preview";
                                    glyph:Glyph.sound;
                                    height:36px;
                                    clicked=>{
                                        root.preview-sound();
                                    }
                                }
                            }
                            CheckBox {
                                text:"Windows notifications";
                                checked <=> root.notifications;
                            }
                            Action {
                                text:"Set up & test notifications";
                                glyph:Glyph.bell;
                                clicked=>{
                                    root.register-notifications();
                                }
                            }
                            Caption {
                                text:"Portable builds need registration again after moving the executable. A tray alert is used when Windows notifications are unavailable.";
                            }
                        }
                        if root.settings-section==2: VerticalLayout {
                            spacing:12px;
                            Text {
                                text:"Quiet by design";
                                color:Tokens.ink;
                                font-size:18px;
                                font-weight:600;
                            }
                            ComboBox {
                                model:["Follow Windows","Light","Dark"];
                                current-index <=> root.appearance;
                                accessible-label:"Color appearance";
                            }
                            CheckBox {
                                text:"Reduce motion";
                                checked <=> root.reduced-motion;
                            }
                            CheckBox {
                                text:"Use Mica when available";
                                checked <=> root.mica;
                            }
                            Caption {
                                text:"Opaque surfaces keep the interface light. Windows high contrast takes precedence.";
                            }
                        }
                        if root.settings-section==3: VerticalLayout {
                            spacing:12px;
                            Text {
                                text:"Within easy reach";
                                color:Tokens.ink;
                                font-size:18px;
                                font-weight:600;
                            }
                            HorizontalLayout {
                                Caption {
                                    text:"Start / pause";
                                    width:100px;
                                    vertical-alignment:center;
                                }
                                LineEdit {
                                    text <=> root.toggle-hotkey;
                                    accessible-label:"Start pause shortcut";
                                    horizontal-stretch:1;
                                }
                                Action {
                                    text:root.recording-shortcut==0 ? "Press keys…" : "Record";
                                    height:34px;
                                    clicked=>{
                                        root.begin-capture(0);
                                        recorder.focus();
                                    }
                                }
                                Action {
                                    glyph:Glyph.close;
                                    description:"Disable start pause shortcut";
                                    quiet:true;
                                    width:34px;
                                    height:34px;
                                    clicked=>{
                                        root.toggle-hotkey="";
                                    }
                                }
                            }
                            HorizontalLayout {
                                Caption {
                                    text:"Show app";
                                    width:100px;
                                    vertical-alignment:center;
                                }
                                LineEdit {
                                    text <=> root.show-hotkey;
                                    accessible-label:"Show app shortcut";
                                    horizontal-stretch:1;
                                }
                                Action {
                                    text:root.recording-shortcut==1 ? "Press keys…" : "Record";
                                    height:34px;
                                    clicked=>{
                                        root.begin-capture(1);
                                        recorder.focus();
                                    }
                                }
                                Action {
                                    glyph:Glyph.close;
                                    description:"Disable show app shortcut";
                                    quiet:true;
                                    width:34px;
                                    height:34px;
                                    clicked=>{
                                        root.show-hotkey="";
                                    }
                                }
                            }
                            HorizontalLayout {
                                Caption {
                                    text:"Skip session";
                                    width:100px;
                                    vertical-alignment:center;
                                }
                                LineEdit {
                                    text <=> root.skip-hotkey;
                                    accessible-label:"Skip shortcut";
                                    horizontal-stretch:1;
                                }
                                Action {
                                    text:root.recording-shortcut==2 ? "Press keys…" : "Record";
                                    height:34px;
                                    clicked=>{
                                        root.begin-capture(2);
                                        recorder.focus();
                                    }
                                }
                                Action {
                                    glyph:Glyph.close;
                                    description:"Disable skip shortcut";
                                    quiet:true;
                                    width:34px;
                                    height:34px;
                                    clicked=>{
                                        root.skip-hotkey="";
                                    }
                                }
                            }
                            Caption {
                                text:"Use Ctrl, Alt, Shift or Win plus a letter, number, Space, or F1–F12. Clear a field to disable it.";
                            }
                            CheckBox {
                                text:"Start in the tray when I sign in";
                                checked <=> root.autostart;
                            }
                        }
                        if root.settings-section==4: VerticalLayout {
                            spacing:16px;
                            for widget[i] in root.widgets: VerticalLayout {
                                spacing: 10px;
                                HorizontalLayout {
                                    VerticalLayout {
                                        spacing: 4px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: widget.title;
                                            color: Tokens.ink;
                                            font-size: 16px;
                                            font-weight: 600;
                                        }
                                        Caption {
                                            text: widget.description;
                                        }
                                    }
                                    CheckBox {
                                        text: "Show";
                                        checked: widget.enabled;
                                        toggled => {
                                            root.widget-change(i,self.checked,widget.layer,widget.click-through);
                                        }
                                    }
                                }
                                if root.widget-advanced: HorizontalLayout {
                                    spacing: 10px;
                                    ComboBox {
                                        accessible-label: widget.title + " window layer";
                                        model: ["Bottom", "Normal", "Always on top"];
                                        current-index: widget.layer;
                                        selected(value) => {
                                            root.widget-change(i,widget.enabled,self.current-index,widget.click-through);
                                        }
                                    }
                                    CheckBox {
                                        text: "Click through";
                                        checked: widget.click-through;
                                        toggled => {
                                            root.widget-change(i,widget.enabled,widget.layer,self.checked);
                                        }
                                    }
                                    Action {
                                        text: "Reset position";
                                        height: 36px;
                                        clicked => {
                                            root.widget-reset(i);
                                        }
                                    }
                                }
                                Rule {
                                }
                            }
                            Action {
                                text: root.widget-advanced ? "Hide advanced controls" : "Advanced controls";
                                quiet: true;
                                clicked => {
                                    root.widget-advanced = !root.widget-advanced;
                                }
                            }
                            Caption {
                                text: "Drag a widget header to move it. Recover controls with Unlock all widgets in the tray.";
                            }
                        }
                        if root.settings-section==5: VerticalLayout {
                            spacing:12px;
                            Text {
                                text:"Your work, on this computer";
                                color:Tokens.ink;
                                font-size:18px;
                                font-weight:600;
                            }
                            Caption {
                                text:root.data-location;
                            }
                            HorizontalLayout {
                                spacing:8px;
                                Action {
                                    text:"Create backup";
                                    glyph:Glyph.save;
                                    enabled:!root.data-busy && !root.storage-blocked && !root.data-busy;
                                    clicked=>{
                                        root.control("backup");
                                    }
                                }
                                Action {
                                    text:"Restore backup";
                                    glyph:Glyph.reset;
                                    enabled:!root.data-busy && !root.storage-blocked && !root.data-busy;
                                    clicked=>{
                                        root.control("restore");
                                    }
                                }
                            }
                            Caption {
                                text:root.data-busy ? "Working…" : root.data-status;
                            }
                            Caption {
                                text:"Backups pause your timer and include tasks, settings, and history. Save a copy on another drive for protection from disk failure. Restore replaces local data after making a recovery backup.";
                            }
                            Action {
                                text:"Open data folder";
                                glyph:Glyph.folder;
                                clicked=>{
                                    root.open-data-folder();
                                }
                            }
                        }
                        if root.settings-section==6: VerticalLayout {
                            spacing:16px;
                            Text {
                                text:"Orbit";
                                font-size:28px;
                                font-weight:600;
                                color:Tokens.ink;
                            }
                            Caption {
                                text:"Opens immediately. Stays light. Your space to focus.";
                            }
                            Caption {
                                text:"Version 0.2.0 · Offline focus timer for Windows";
                            }
                            Caption {
                                text:"Application code: MIT. Third-party license texts are included with your download.";
                            }
                            AboutSlint {
                                width:280px;
                                height:112px;
                            }
                        }
                    }
                }
                Rule {
                }
                HorizontalLayout {
                    spacing:8px;
                    Caption {
                        text:root.settings-saving ? "Saving…" : root.settings-dirty ? "Unsaved changes" : "Settings saved";
                        horizontal-stretch:1;
                        vertical-alignment:center;
                    }
                    Action {
                        text:"Discard";
                        height:38px;
                        enabled:root.settings-dirty && !root.settings-saving;
                        clicked=>{
                            root.control("discard-settings");
                        }
                    }
                    Action {
                        text:"Save";
                        glyph:Glyph.save;
                        height:38px;
                        primary:true;
                        tint:Tokens.coral;
                        enabled:root.settings-dirty && !root.settings-saving && !root.storage-blocked && !root.data-busy;
                        clicked=>{
                            root.save-settings();
                        }
                    }
                }
            }
        }
    }
    recorder:=FocusScope {
        width:0px;
        height:0px;
        key-pressed(event)=>{
            if root.recording-shortcut<0 {
                return reject;
            }
            if event.text==Key.Escape {
                root.cancel-capture();
                return accept;
            }
            if event.modifiers.control || event.modifiers.alt || event.modifiers.shift || event.modifiers.meta {
                root.capture-shortcut(root.recording-shortcut,(event.modifiers.control ? "Ctrl+" : "")+(event.modifiers.alt ? "Alt+" : "")+(event.modifiers.shift ? "Shift+" : "")+(event.modifiers.meta ? "Win+" : "")+event.text);
            }
            return accept;
        }
    }
    picker:=PopupWindow {
        x:root.compact ? 176px : 196px;
        y:116px;
        width:min(480px,root.width - 200px);
        height:340px;
        Rectangle {
            background:Tokens.paper;
            border-radius:10px;
            border-width:1px;
            border-color:Tokens.line;
            VerticalLayout {
                padding:16px;
                spacing:10px;
                Text {
                    text:"Choose your next focus";
                    color:Tokens.ink;
                    font-size:18px;
                    font-weight:600;
                }
                LineEdit {
                    text <=> root.task-search;
                    placeholder-text:"Search active tasks";
                    accessible-label:"Search focus tasks";
                    edited=>{
                        root.filter-tasks();
                    }
                }
                ListView {
                    vertical-stretch:1;
                    for task in root.tasks: HorizontalLayout {
                        height:44px;
                        spacing:8px;
                        Text {
                            text:task.title;
                            overflow:elide;
                            color:Tokens.ink;
                            horizontal-stretch:1;
                            vertical-alignment:center;
                        }
                        Action {
                            text:"Use";
                            height:34px;
                            enabled:!root.storage-blocked && !root.data-busy;
                            clicked=>{
                                root.task-action(task.id,"select");
                                picker.close();
                            }
                        }
                    }
                }
                Action {
                    text:"Focus without a task";
                    height:34px;
                    clicked=>{
                        root.task-action(-1,"select");
                        picker.close();
                    }
                }
            }
        }
    }
    details:=PopupWindow {
        x:176px;
        y:130px;
        width:min(480px,root.width - 200px);
        height:340px;
        Rectangle {
            background:Tokens.paper;
            border-width:1px;
            border-color:Tokens.line;
            border-radius:10px;
            VerticalLayout {
                padding:20px;
                spacing:16px;
                Text {
                    text:root.detail-title;
                    wrap:word-wrap;
                    color:Tokens.ink;
                    font-size:17px;
                }
                ListView {
                    vertical-stretch:1;
                    for row in root.detail-rows: Text {
                        text:row;
                        wrap:word-wrap;
                        color:Tokens.muted;
                        font-size:12px;
                        min-height:42px;
                    }
                }
                Action {
                    text:"Close";
                    height:36px;
                    clicked=>{
                        details.close();
                    }
                }
            }
        }
    }
}
export component TimerWidget inherits Window {
    in property <bool> storage-blocked;
    in property <bool> started;
    property <bool> dark-mode: Tokens.dark;
    init => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-mode => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    title: "Orbit · Timer widget";
    width: 230px;
    height: 284px;
    no-frame: true;
    background: Tokens.paper;
    default-font-family: "Segoe UI";
    in property <string> time-text;
    in property <string> ring-path;
    in property <string> mode-label;
    in property <color> accent: Tokens.coral;
    in property <bool> running;
    callback control(string);
    VerticalLayout {
        padding: 15px;
        spacing: 10px;
        Rectangle {
            height: 24px;
            background: transparent;
            Text {
                text: "Orbit · " + root.mode-label;
                color: Tokens.muted;
                font-size: 10px;
                vertical-alignment: center;
            }
            WindowMoveArea {
            }
        }
        Rectangle {
            height: 174px;
            background: transparent;
            Ring {
                time: root.time-text;
                path: root.ring-path;
                label: root.storage-blocked ? "Saving interrupted" : root.mode-label;
                accent: root.accent;
                width: 174px;
                height: 174px;
                x: (parent.width - self.width) / 2;
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Action {
                text: root.storage-blocked ? "Retry save" : root.running ? "Pause" : root.started ? "Resume" : "Start";
                glyph: root.running ? Glyph.pause : Glyph.play;
                height: 36px;
                clicked => {
                    root.control(root.storage-blocked ? "retry" : "toggle");
                }
            }
            Action {
                glyph: Glyph.skip;
                description: "Skip session";
                enabled: !root.storage-blocked;
                width: 36px;
                height: 36px;
                clicked => {
                    root.control("skip");
                }
            }
            Action {
                glyph: Glyph.close;
                description: "Close timer widget";
                width: 36px;
                height: 36px;
                clicked => {
                    root.control("close");
                }
            }
        }
    }
}
export component TasksWidget inherits Window {
    in property <bool> storage-blocked;
    in property <bool> started;
    property <bool> dark-mode: Tokens.dark;
    init => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-mode => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    title: "Orbit · Today widget";
    width: 320px;
    height: 330px;
    no-frame: true;
    background: Tokens.paper;
    default-font-family: "Segoe UI";
    in property <[TaskRow]> tasks;
    in property <string> today-label: "Today's focus";
    callback control(string);
    callback select-task(int);
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Rectangle {
            height: 38px;
            background: transparent;
            VerticalLayout {
                Text {
                    text: "Today's tasks";
                    color: Tokens.ink;
                    font-size: 16px;
                    font-weight: 600;
                }
                Caption {
                    text: root.storage-blocked ? "Saving interrupted. Open Orbit to recover." : root.today-label;
                }
            }
            WindowMoveArea {
            }
        }
        Rule {
        }
        if root.tasks.length == 0: Caption {
            text: "No tasks planned for today. Open Orbit to choose a few.";
        }
        ListView {
            vertical-stretch: 1;
            for task in root.tasks: Rectangle {
                height: 48px;
                background: task.selected ? Tokens.selected : transparent;
                border-radius: 5px;
                HorizontalLayout {
                    padding: 5px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text {
                            text: task.title;
                            overflow: elide;
                            color: task.selected && Tokens.high-contrast ? Tokens.system-highlight-text : Tokens.ink;
                        }
                        Caption {
                            color: task.selected && Tokens.high-contrast ? Tokens.system-highlight-text : Tokens.muted;
                            text: task.completed + " / " + task.estimate + " sessions";
                        }
                    }
                    Action {
                        glyph: task.done || task.selected ? Glyph.check : Glyph.play;
                        on-selection: task.selected;
                        width: 36px;
                        height: 36px;
                        enabled: !task.done && !root.storage-blocked;
                        description: task.done ? "Completed: " + task.title : "Select " + task.title;
                        clicked => {
                            root.select-task(task.id);
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Action {
                text: "Open Orbit";
                glyph: Glyph.orbit;
                height: 36px;
                clicked => {
                    root.control("show");
                }
            }
            Action {
                glyph: Glyph.close;
                description: "Close task widget";
                width: 36px;
                height: 36px;
                clicked => {
                    root.control("close");
                }
            }
        }
    }
}
