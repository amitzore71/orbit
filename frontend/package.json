{
  "name": "orbit-desktop",
  "version": "0.3.1",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop": "cargo run --manifest-path ../crates/app/Cargo.toml --no-default-features --locked",
    "desktop:build": "pnpm build && cargo build --manifest-path ../crates/app/Cargo.toml --release --locked"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@phosphor-icons/react": "^2.1.10",
    "geist": "^1.4.2",
    "motion": "14.4.0",
    "next": "16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
